# Copie ce fichier en .env et remplis les valeurs. Le .env réel est gitignoré (jamais committé).

# RPC Solana WebSocket. Vide = RPC public (OK pour tester, rate-limité).
# Pour du 24/7 fiable, mets une clé Helius gratuite :
# RPC_WS="wss://mainnet.helius-rpc.com/?api-key=TA_CLE"
RPC_WS=

# Alertes Telegram (multi_watch.js). Token via @BotFather, chat_id via getUpdates.
TG_TOKEN=
TG_CHAT=

# Alerte de repli ntfy.sh (optionnel, si pas de Telegram)
NTFY_TOPIC=

# Seuils "survivant" (multi_watch.js)
SURVIVOR_MIN_S=300
SURVIVOR_MIN_REALSOL=20

# Backtester paper_sniper.js
LATENCY_MS=1500
BUY_SOL=0.05
TP=0.5
SL=0.4
TIMEOUT_S=120
TIP_SOL=0.001
# JITO_MODE=1
# JITO_TIP=0.005
